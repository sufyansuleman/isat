{
  "name": "isat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @isat/web",
    "build:web": "npm run build -w @isat/web",
    "cli": "vite-node packages/cli/src/main.ts --",
    "prepare": "git config core.hooksPath .githooks || true",
    "docs": "vite-node scripts/gen-docs.ts"
  }
}
